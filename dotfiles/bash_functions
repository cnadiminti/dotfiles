function nvd-download-feed() {
  [ -f nvd-feed.ndjson ] && rm -f nvd-feed.ndjson
  local startIndex=0
  local resultsPerPage=2000
  local resp totalResults
  while true; do
    echo "$startIndex $resultsPerPage ..."
    resp=$(curl -s "https://services.nvd.nist.gov/rest/json/cves/2.0?startIndex=$startIndex&resultsPerPage=$resultsPerPage")
    echo "$resp" | jq -c '.vulnerabilities[]' >> nvd-feed.ndjson

    totalResults=$(echo "$resp" | jq -r .totalResults)
    resultsPerPage=$(echo "$resp" | jq -r .resultsPerPage)
    startIndex=$(( $(echo "$resp" | jq .startIndex) + resultsPerPage))
    if [[ $startIndex -ge $totalResults ]]; then
      break
    fi
    # https://nvd.nist.gov/developers/start-here
    sleep 10 #6
  done
}

# Switch JDK versions using macOS java_home utility
# Usage: jdk_switch <version>
# Example: jdk_switch 17
function jdk_switch {
    if [[ $# -ne 1 ]]; then
        echo "Usage: jdk_switch <version>"
        echo "Example: jdk_switch 17"
        return 1
    fi

    local version="$1"
    # Separate declare and assign for proper error handling (SC2155)
    JAVA_HOME="$(/usr/libexec/java_home --version "${version}" 2>/dev/null)"

    if [[ -z "$JAVA_HOME" ]]; then
        echo "Error: JDK version ${version} not found"
        return 1
    fi

    export JAVA_HOME
    echo "Switched to JDK ${version}: ${JAVA_HOME}"
    java -version
}

# Convenience aliases for common JDK versions
alias jdk11='jdk_switch 11'
alias jdk17='jdk_switch 17'
alias jdk21='jdk_switch 21'
