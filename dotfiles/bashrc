#!/usr/bin/env bash

# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# ============================================================================
# CORE SHELL SETTINGS
# ============================================================================

# If not running interactively, don't do anything
[ -z "$PS1" ] && return

# Default editor
export EDITOR=vi

# History configuration
HISTCONTROL=ignoreboth      # Don't save duplicates or commands starting with space
HISTSIZE=1000               # Commands in memory
HISTFILESIZE=2000           # Commands in history file
shopt -s histappend         # Append to history file, don't overwrite

# Shell behavior options
shopt -s checkwinsize       # Update LINES and COLUMNS after each command

# Make less more friendly for non-text input files
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ============================================================================
# PROMPT CONFIGURATION
# ============================================================================

# Debian chroot identification
if [ -z "$debian_chroot" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# Color prompt setup
case "$TERM" in
    xterm-color|xterm-256color)
        color_prompt=yes
        export CLICOLOR=1
        ;;
esac

force_color_prompt=yes
if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;31m\]\W\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# Set xterm title to user@host:dir
case "$TERM" in
    xterm*|rxvt*)
        PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
        ;;
esac

# OpenStack environment indicator
PROMPT_COMMAND="if [ -n \"\$OS_AUTH_URL\" ]; then echo [\$(echo \$OS_AUTH_URL)]; fi"

# Alert alias for long-running commands (use like: sleep 10; alert)
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# ============================================================================
# PACKAGE MANAGERS & CORE SYSTEM
# ============================================================================

# Homebrew and MacPorts
export PATH="/opt/homebrew/bin:/opt/local/bin:$PATH"
export PATH="/opt/homebrew/opt/bison/bin:$PATH"  # Override system bison

# User-local binaries (pipx, etc.)
export PATH="$PATH:$HOME/.local/bin"

# ============================================================================
# PLATFORM-SPECIFIC CONFIGURATION
# ============================================================================

# MAC OS X
if [ "$(uname -s)" = "Darwin" ]; then
	  eval "$(brew shellenv)"
    # Cache brew --prefix for performance (avoids 200-400ms per call)
    if command -v brew >/dev/null 2>&1; then
        HOMEBREW_PREFIX="$(brew --prefix)"
    fi
    alias alert='terminal-notifier -message "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

    # macOS-specific PATH additions
    export PATH="$PATH:/Applications/IntelliJ IDEA.app/Contents/MacOS"

    # GRC (generic colouriser)
    if [ -r "${HOMEBREW_PREFIX}/etc/grc.bashrc" ]; then
        # shellcheck source=/dev/null
        source "${HOMEBREW_PREFIX}/etc/grc.bashrc"
    fi
else
# Linux
    # enable programmable completion features (you don't need to enable
    # this, if it's already enabled in /etc/bash.bashrc and /etc/profile
    # sources /etc/bash.bashrc).
    if [ -r /etc/bash_completion ] && ! shopt -oq posix; then
        # shellcheck source=/dev/null
        source /etc/bash_completion
    fi
fi

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Docker
export PATH="$PATH:$HOME/.docker/bin"
export DOCKER_DEFAULT_PLATFORM=linux/amd64
export DOCKER_HOST="unix://$HOME/.docker/run/docker.sock"
export DOCKER_CLI_HINTS=false

# Go
mkdir -p "${HOME}/go"
export GOPATH=$HOME/go
export GO111MODULE=on
export PATH="$PATH:$GOPATH/bin"

# Java (use jdk11/jdk17/jdk21 functions from bash_functions to switch versions)
if [ -x /usr/libexec/java_home ]; then
    JAVA_HOME="$(/usr/libexec/java_home)"
    export JAVA_HOME
fi

# Node.js (nvm)
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# Kubernetes
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"  # krew plugin manager

# Vagrant
export PATH="/opt/vagrant-vmware-desktop/bin:$PATH"

# MySQL Workbench
export PATH="$PATH:/Applications/MySQLWorkbench.app/Contents/MacOS"

# ============================================================================
# AI/ML TOOLS
# ============================================================================

# Claude Code
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# Windsurf (Codeium)
export PATH="${HOME}/.codeium/windsurf/bin:$PATH"

# LM Studio
export PATH="$PATH:${HOME}/.lmstudio/bin"

# ============================================================================
# CUSTOM FUNCTIONS AND ALIASES
# ============================================================================

# Function definitions.
# You may want to put all your additions into a separate file like
# ${HOME}/.bash_functions, instead of adding them here directly.
if [ -r "${HOME}/.bash_functions" ]; then
    # shellcheck source=/dev/null
     source "${HOME}/.bash_functions"
fi

# Alias definitions.
# You may want to put all your additions into a separate file like
# ${HOME}/.bash_aliases, instead of adding them here directly.

if [ -r "${HOME}/.bash_aliases" ]; then
    # shellcheck source=/dev/null
     source "${HOME}/.bash_aliases"
fi

# Company/personal configurations (gitignored)
# Put passwords, tokens, company-specific aliases/functions here
if [ -r "${HOME}/.bashrc.local" ]; then
    # shellcheck source=/dev/null
     source "${HOME}/.bashrc.local"
fi

# ============================================================================
# SHELL COMPLETIONS
# ============================================================================

# Homebrew bash completions (HOMEBREW_PREFIX cached in Darwin section)
if [[ -n "${HOMEBREW_PREFIX}" ]]; then
  if [[ -r "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]]; then
    # shellcheck source=/dev/null
    source "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
  else
    for COMPLETION in "${HOMEBREW_PREFIX}/etc/bash_completion.d/"*; do
      # shellcheck source=/dev/null
      [[ -r "${COMPLETION}" ]] && source "${COMPLETION}"
    done
  fi
fi

# Kubectl (Kubernetes CLI)
if command -v kubectl >/dev/null 2>&1; then
    # shellcheck source=/dev/null
    source <(kubectl completion bash)
    alias k=kubectl
    complete -F __start_kubectl k
fi

# 1Password CLI
# shellcheck source=/dev/null
command -v op >/dev/null 2>&1 && source <(op completion bash)

# GitLab CLI
# shellcheck source=/dev/null
command -v glab >/dev/null 2>&1 && source <(glab completion -s bash)

# Google Cloud SDK
if [[ -n "${HOMEBREW_PREFIX}" && -r "${HOMEBREW_PREFIX}/share/google-cloud-sdk/path.bash.inc" ]]; then
    # shellcheck source=/dev/null
    source "${HOMEBREW_PREFIX}/share/google-cloud-sdk/path.bash.inc"
fi

